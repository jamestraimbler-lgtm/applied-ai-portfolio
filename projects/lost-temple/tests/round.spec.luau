local Round = require("../src/Round")
local function completeWave(state, wave)
	assert(Round.beginWave(state, wave, false))
	Round.closeWarning(state, wave)
	return Round.rewardWave(state, wave)
end
local passed = 0
local function check(name, fn)
	fn()
	passed += 1
	print("PASS", name)
end

check("a single player can start and win", function()
	local state = Round.new(1, {123})
	assert(Round.count(state) == 1)
	for wave = 1, 6 do assert(completeWave(state, wave)[123] == 10) end
	assert(Round.finish(state, true)[123] == 25)
end)
check("eliminated players receive no later rewards", function()
	local state = Round.new(1, {1, 2})
	assert(Round.eliminate(state, 1))
	assert(Round.count(state) == 1)
	assert(completeWave(state, 1)[1] == nil)
	local wins = Round.finish(state, true)
	assert(wins[1] == nil and wins[2] == 25)
end)
check("late joiners and unknown identities cannot receive rewards", function()
	local state = Round.new(1, {1})
	assert(not Round.eliminate(state, 99))
	assert(completeWave(state, 1)[99] == nil)
	assert(Round.finish(state, true)[99] == nil)
end)
check("repeated death or disconnect has no duplicate effect", function()
	local state = Round.new(1, {1, 2})
	assert(Round.eliminate(state, 1))
	assert(not Round.eliminate(state, 1))
	assert(Round.count(state) == 1)
end)
check("wave and victory rewards are idempotent", function()
	local state = Round.new(1, {1})
	assert(completeWave(state, 1)[1] == 10)
	assert(next(Round.rewardWave(state, 1)) == nil)
	assert(Round.finish(state, true)[1] == 25)
	assert(next(Round.finish(state, true)) == nil)
	assert(next(Round.rewardWave(state, 2)) == nil)
end)
check("an abandoned round pays no win bonus", function()
	local state = Round.new(1, {1})
	assert(next(Round.finish(state, false)) == nil)
	assert(not Round.eliminate(state, 1))
	assert(next(Round.finish(state, true)) == nil)
end)
check("all eliminated players end with no winners", function()
	local state = Round.new(1, {1, 2})
	Round.eliminate(state, 1)
	Round.eliminate(state, 2)
	assert(Round.count(state) == 0)
	assert(next(Round.finish(state, true)) == nil)
end)
check("a fresh round does not reuse the last roster or rewards", function()
	local old = Round.new(1, {1})
	completeWave(old, 1)
	Round.finish(old, true)
	local fresh = Round.new(2, {2})
	assert(fresh.alive[1] == nil)
	assert(completeWave(fresh, 1)[2] == 10)
end)

check("a bonus is pending until the warning closes and the shift is survived", function()
	local state = Round.new(1, {1})
	assert(Round.beginWave(state, 1, true))
	assert(Round.collectBonus(state, 1, 1))
	assert(next(Round.rewardWave(state, 1)) == nil)
	Round.closeWarning(state, 1)
	assert(Round.rewardWave(state, 1)[1] == 15)
	assert(next(Round.rewardWave(state, 1)) == nil)
end)
check("two players can collect the same bonus independently", function()
	local state = Round.new(1, {1, 2})
	assert(Round.beginWave(state, 1, true))
	assert(Round.collectBonus(state, 1, 1))
	assert(not Round.collectBonus(state, 1, 1))
	assert(Round.collectBonus(state, 2, 1))
	Round.closeWarning(state, 1)
	local rewards = Round.rewardWave(state, 1)
	assert(rewards[1] == 15 and rewards[2] == 15)
end)
check("dead, disconnected and unknown players cannot collect or bank a bonus", function()
	local state = Round.new(1, {1, 2, 3})
	assert(Round.beginWave(state, 1, true))
	assert(Round.collectBonus(state, 1, 1))
	assert(Round.collectBonus(state, 2, 1))
	Round.eliminate(state, 1)
	Round.eliminate(state, 2)
	assert(not Round.collectBonus(state, 1, 1))
	assert(not Round.collectBonus(state, 99, 1))
	Round.closeWarning(state, 1)
	local rewards = Round.rewardWave(state, 1)
	assert(rewards[1] == nil and rewards[2] == nil and rewards[3] == 10)
end)
check("bonus collection fails outside the warning and after the round ends", function()
	local state = Round.new(1, {1})
	assert(not Round.collectBonus(state, 1, 0))
	assert(Round.beginWave(state, 1, true))
	Round.closeWarning(state, 1)
	assert(not Round.collectBonus(state, 1, 1))
	Round.finish(state, false)
	assert(not Round.collectBonus(state, 1, 1))
end)
check("teaching and laser shifts cannot award bonuses", function()
	local state = Round.new(1, {1})
	assert(Round.beginWave(state, 1, false))
	assert(not Round.collectBonus(state, 1, 1))
	Round.closeWarning(state, 1)
	assert(Round.rewardWave(state, 1)[1] == 10)
end)
check("stale wave events cannot affect a later wave", function()
	local state = Round.new(1, {1})
	assert(Round.beginWave(state, 1, true))
	assert(Round.collectBonus(state, 1, 1))
	Round.closeWarning(state, 1)
	assert(Round.rewardWave(state, 1)[1] == 15)
	assert(Round.beginWave(state, 2, true))
	assert(not Round.collectBonus(state, 1, 1))
	Round.closeWarning(state, 1)
	assert(state.warningOpen)
	Round.closeWarning(state, 2)
	assert(Round.rewardWave(state, 2)[1] == 10)
end)
check("waves cannot skip, replay, overlap or continue beyond six", function()
	local state = Round.new(1, {1})
	assert(not Round.beginWave(state, 2, true))
	assert(Round.beginWave(state, 1, true))
	assert(not Round.beginWave(state, 1, true))
	assert(not Round.beginWave(state, 2, true))
	Round.closeWarning(state, 1)
	Round.rewardWave(state, 1)
	for wave = 2, 6 do completeWave(state, wave) end
	assert(not Round.beginWave(state, 7, true))
end)
check("a full round with four bonuses banks 105 coins", function()
	local state = Round.new(1, {1})
	local total = 0
	for wave = 1, 6 do
		local bonus = wave ~= 2 and wave ~= 5
		assert(Round.beginWave(state, wave, bonus))
		if bonus then assert(Round.collectBonus(state, 1, wave)) end
		Round.closeWarning(state, wave)
		total += Round.rewardWave(state, wave)[1]
	end
	total += Round.finish(state, true)[1]
	assert(total == 105)
end)
print(string.format("%d round lifecycle tests passed", passed))
